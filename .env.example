# Thymble Server configuration — placeholder values only.
# Copy to .env and fill in real values. Never commit .env.

# Database
POSTGRES_PASSWORD=change-me

# Public URL the app connects to
THYMBLE_PUBLIC_URL=https://thymble.example.com

# LLM providers (both optional; tasks route to whichever is configured)
ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=http://ollama:11434/v1
LOCAL_MODEL=gemma3:4b

# Email sign-in (magic links) — optional; Sign in with Apple works without it
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=thymble@example.com
