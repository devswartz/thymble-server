# Thymble Server configuration — placeholder values only.
# Copy to .env and fill in real values. Never commit .env.
# For local development, `python scripts/dev_env.py` writes a .env with random dev-only secrets.

# General: development | production | test
THYMBLE_ENV=production
LOG_LEVEL=info

# Database (the compose stack builds the connection from these)
POSTGRES_USER=thymble
POSTGRES_DB=thymble
POSTGRES_PASSWORD=change-me
# Optional: a full URL instead of the POSTGRES_* parts (e.g. an external database)
# DATABASE_URL=postgresql://thymble:change-me@postgres:5432/thymble

# Redis job queue
REDIS_URL=redis://redis:6379/0

# Public URL the app connects to
THYMBLE_PUBLIC_URL=https://thymble.example.com

# PowerSync
# Public URL of the PowerSync service, handed to the app along with its sync token
POWERSYNC_URL=https://thymble.example.com/powersync
# Password for the replication role PowerSync uses to read Postgres
POWERSYNC_DB_PASSWORD=change-me
# HS256 key the api signs sync JWTs with and PowerSync verifies (base64url of 32+ random bytes)
POWERSYNC_JWT_SECRET=change-me
# Token for PowerSync's admin API (diagnostics)
POWERSYNC_API_TOKEN=change-me

# LLM providers (both optional; tasks route to whichever is configured).
# Leave a provider blank to turn it off; /v1/capabilities reports llm=true when any is set.
ANTHROPIC_API_KEY=
# e.g. http://ollama:11434/v1 for Ollama
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
LOCAL_MODEL=gemma3:4b
# Vision model for photo transcription on the local endpoint (blank = LOCAL_MODEL)
LOCAL_VISION_MODEL=
# Claude models: small tasks (T3-T8) and hard tasks (T1 page extraction, T2 photos)
ANTHROPIC_MODEL_SMALL=claude-haiku-5-5
ANTHROPIC_MODEL_LARGE=claude-sonnet-5-5
# Per-task routing: anthropic | local | none. Blank = default (T1, T2 -> anthropic; T3-T8 -> local).
# T1 page -> recipe, T2 photo/text -> recipe, T3 ingredient line, T4 ingredient name,
# T5 voice item, T6 product pick, T7 aisle, T8 step timers
LLM_ROUTE_T1=
LLM_ROUTE_T2=
LLM_ROUTE_T3=
LLM_ROUTE_T4=
LLM_ROUTE_T5=
LLM_ROUTE_T6=
LLM_ROUTE_T7=
LLM_ROUTE_T8=
# Seconds before a call gives up and falls back to the other provider (if configured)
LLM_TIMEOUT_SECONDS=90
LLM_LOCAL_TIMEOUT_SECONDS=120
LLM_FALLBACK=true
# Monthly cap on uncached LLM tokens per household (0 = no cap)
LLM_HOUSEHOLD_MONTHLY_TOKEN_LIMIT=0

# Recipe import
# Server-side page fetch is a fallback; the app normally sends the page it already loaded
IMPORT_SERVER_FETCH_ENABLED=true
IMPORT_FETCH_TIMEOUT_SECONDS=20
IMPORT_MAX_HTML_BYTES=5000000
IMPORT_MAX_PHOTO_BYTES=10000000

# Email sign-in (magic links) — optional; Sign in with Apple works without it
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=thymble@example.com

# Features reported by /v1/capabilities
PHOTO_IMPORT_ENABLED=true
# Comma-separated connector ids, e.g. home_assistant  /  kroger,walmart
CONNECTORS_LISTS=
CONNECTORS_RETAILERS=
SHARED_LEARNING=false

# Host ports published by docker compose (change if they clash with something local)
# THYMBLE_API_PORT=8000
# POWERSYNC_PORT=8080
# Dev override only (bound to 127.0.0.1):
# POSTGRES_PORT=15432
# REDIS_PORT=16379
